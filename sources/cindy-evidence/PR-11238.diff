+
+/**
+ * 自动化收起后只保留一个入口，因此连旧运行的等待回复和运行中状态也必须汇总。
+ * 普通项目仍沿用红/绿汇总；这里复用其告警判据，再补齐自动化的五档状态与打开目标。
+ */
+export function resolveCollapsedAutomationGroupState(
+  input: CollapsedAttentionInput & {
