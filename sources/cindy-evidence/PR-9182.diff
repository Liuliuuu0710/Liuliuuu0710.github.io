@@ -1,10 +1,16 @@
-/* Both reply runtimes use the same narrow-panel presentation. Controls stay in
-   flow below the content, leaving the full message column available for reading. */
-.thread-panel {
+/* Private topics keep controls in flow below the content. Group topics retain
+   the main timeline toolbar and its side gutter, clear of the read receipt. */
+/* A group topic has reaction + more, rather than the main chat's four actions.
+   Keep that outer rail without sacrificing another 56px of narrow-panel text. */
+.thread-panel:not(.thread-panel-inline-actions) {
+  --chat-bubble-gutter: 64px;
+}
+
+.thread-panel-inline-actions {
   --chat-bubble-gutter: 0px;
 }
 
-.thread-panel .chat-bubble-toolbar {
+.thread-panel-inline-actions .chat-bubble-toolbar {
   position: relative;
   inset: auto;
   margin: 8px 0 0 auto;

